# PayReconcile needs NO secrets, API keys or credentials. Everything runs locally on synthetic data.
# These optional variables only relocate files or point the ingestion client at the local API.

# Where sources, Bronze, the DuckDB warehouse and ground truth live (default: ./data)
# PAYRECON_DATA=./data

# Base URL of the local gateway API (python -m payreconcile serve-api); used by --source api
# PAYRECON_API_URL=http://127.0.0.1:8765

# DuckDB file used by dbt (set automatically by the pipeline; only needed when running dbt by hand)
# PAYRECON_DB=./data/warehouse.duckdb
